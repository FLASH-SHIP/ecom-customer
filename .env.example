# ==============================================================================
# Customer Portal Next.js App Environment Variables Template
# ==============================================================================

NODE_ENV="development"

# ------------------------------------------------------------------------------
# 1. NextAuth.js (Auth.js v5) Configuration
# ------------------------------------------------------------------------------
# Primary secret used to encrypt session tokens/cookies (minimum 32 characters)
AUTH_SECRET="dev-secret-do-not-use-in-production"

# Absolute URL of the Customer Portal application
NEXTAUTH_URL="http://localhost:3001"
AUTH_URL="http://localhost:3001"

# Trust headers from reverse proxies (required when hosted behind Nginx/Cloudflare)
AUTH_TRUST_HOST="true"

# ------------------------------------------------------------------------------
# 2. Session Control & JWT Configurations
# ------------------------------------------------------------------------------
JWT_SECRET="dev-jwt-secret-do-not-use-in-production"
CUSTOMER_SESSION_CACHE_TTL_SEC=30
CUSTOMER_SESSION_MAX_AGE_DAYS=30
CUSTOMER_SESSION_ABSOLUTE_TIMEOUT_DAYS=90
CUSTOMER_SESSION_IDLE_TIMEOUT_DAYS=7
CUSTOMER_MAX_SESSIONS_PER_USER=10

# ------------------------------------------------------------------------------
# 3. Client / Public Parameters (Exposed to Browser)
# ------------------------------------------------------------------------------
# Backend NestJS API Endpoint
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Self Frontend Customer Portal Endpoint
NEXT_PUBLIC_APP_URL="http://localhost:3001"
NEXT_PUBLIC_CUSTOMER_URL="http://localhost:3001"

# Landing Web Endpoint
NEXT_PUBLIC_WEB_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 4. OAuth 2.0 Social Logins (Optional)
# ------------------------------------------------------------------------------
# Google OAuth
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Facebook OAuth
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
